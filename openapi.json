  "components": {
    "schemas": {
      "AdminLogin": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "AdminLogin"
      },
      "Answer": {
        "properties": {
          "block_index": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Block Index"
          },
          "answer": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "block_index",
          "answer"
        ],
        "title": "Answer"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "init_data": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Init Data"
          }
        },
        "type": "object",
        "required": [
          "init_data"
        ],
        "title": "Login"
      },
      "PreparationLink": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 20,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "PreparationLink"
      },
      "QuizAnswer": {
        "properties": {
          "index": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Index"
          },
          "choice_index": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Choice Index"
          },
          "matching_order": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matching Order"
          }
        },
        "type": "object",
        "required": [
          "index"
        ],
        "title": "QuizAnswer"
      },
      "QuizStep": {
        "properties": {
          "index": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Index"
          }
        },
        "type": "object",
        "required": [
          "index"
        ],
        "title": "QuizStep"
      },
      "ScheduleEntry": {
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "period": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Period"
          },
          "subject": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Subject"
          },
          "topic": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Topic"
          },
          "homework": {
            "type": "string",
            "maxLength": 1000,
            "title": "Homework"
          },
          "assessment": {
            "type": "boolean",
            "title": "Assessment",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "day",
          "period",
          "subject",
          "topic",
          "homework"
        ],
        "title": "ScheduleEntry"
      },
      "Step": {
        "properties": {
          "block_index": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Block Index"
          }
        },
        "type": "object",
        "required": [
          "block_index"
        ],
        "title": "Step"
      },
      "Topic": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Subject"
          },
          "topic": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Topic"
          }
        },
        "type": "object",
        "required": [
          "subject",
          "topic"
        ],
        "title": "Topic"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "StudentSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Session returned by POST /api/auth/max; valid for 24 hours."
      },
      "AdminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "luchik_admin",
        "description": "Separate admin session; only needed for schedule administration."
      },
      "MaxWebhookSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Max-Bot-Api-Secret"
      }
    }
  },
