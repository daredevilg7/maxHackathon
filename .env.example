# 1. Ключ бота MAX (не публикуйте этот файл после заполнения).
MAX_BOT_TOKEN=
# Username без @: команда python -m app.cli check подскажет значение.
MAX_BOT_USERNAME=
MAX_API_URL=https://platform-api2.max.ru
# Если MAX требует дополнительный доверенный сертификат: путь к PEM bundle внутри контейнера.
MAX_CA_BUNDLE=

# 2. Ключ из личного кабинета RouterAI.
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODEL=inclusionai/ling-3.0-flash-vl

# 3. Локальный просмотр. Для настоящего AI/MAX установите false.
DEMO_MODE=true
# disabled = только сайт; polling = разработка; webhook = сервер.
BOT_MODE=disabled
PORT=8000

# 4. Публичный сервер. HTTPS без завершающего /.
DOMAIN=
PUBLIC_BASE_URL=
# Случайная строка не короче 24 символов. Генерация: docker compose run --rm app python -m app.cli secret
WEBHOOK_SECRET=

# 5. Отдельный пароль админ-панели /admin (минимум 16 символов).
ADMIN_PASSWORD=
